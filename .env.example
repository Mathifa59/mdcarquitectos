# Copie este archivo a .env.local y complete los valores. NUNCA suba .env.local al repositorio.

# Clave de API de Resend (https://resend.com/api-keys). Requerida para enviar el formulario de contacto.
RESEND_API_KEY=

# Correo que recibe las consultas del formulario. TODO-CONFIRMAR con la clienta.
CONTACT_TO_EMAIL=

# Remitente (opcional). Debe pertenecer a un dominio verificado en Resend;
# si se omite se usa onboarding@resend.dev, que solo sirve para pruebas.
# Ejemplo: "MD&C Arquitectos <web@mdc-arquitectos.com>"
CONTACT_FROM_EMAIL=
